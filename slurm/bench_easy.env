# GIBSON-REPLICATION BAND: easy (route 5-10 m; Gibson easy is geodesic 1.5-3 m).
#
# Layered on the CHECKPOINT'S OWN training overlay (BENCH_BASE_OVERLAY, default
# v30's), so the env, reward and network match what the policy trained on and
# only the episode distribution changes.
#
# WHY EACH DIFFICULTY HAS ITS OWN BAND. Probing showed our 5-25 m goals are
# almost all ~20-25 m: 85% of origins sit before a junction and
# GOAL_PAST_JUNCTION keeps only distances >= 15 m past it. So an easy bin cannot
# be filled by filtering the standard draw; it is GENERATED from its own band, as
# Mezghani's set was generated per difficulty. The band is part of the episode
# (a seed replayed under another band is a different episode), and it must be
# set HERE -- train_sac.sbatch hard-exports GOAL_DIST_MIN/MAX before sourcing the
# overlay, so a band given on the command line is silently overwritten.
#
# Draws 5..9 m (step 1): route distance >= the drawn lane distance, so drawing
# up to 10 would put the top draws in the medium bin and waste them.
. "$REPO/${BENCH_BASE_OVERLAY:-slurm/v30_overlay.env}"
export BENCH_BAND=easy GOAL_DIST_MIN=5 GOAL_DIST_MAX=9 GOAL_DIST_STEP=1
# Gibson's success radius. 2 m is scored from the same run (EpisodeTracker).
export GOAL_RADIUS_M=1.0
