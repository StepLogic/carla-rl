# HARD-GOAL BAND (user 2026-11-09: "we need hard goals to show map works"): goals
# drawn 50-149 m along the road; the episode set then keeps only routes with >= 2
# junction TURNS (EVAL_PROBE_TURNS), so following the lane cannot reach them.
# Layered on BENCH_BASE_OVERLAY like the other bands; 1 m arrival.
. "$REPO/${BENCH_BASE_OVERLAY:-slurm/v30_overlay.env}"
export BENCH_BAND=turns GOAL_DIST_MIN=50 GOAL_DIST_MAX=149 GOAL_DIST_STEP=1
export GOAL_RADIUS_M=1.0
