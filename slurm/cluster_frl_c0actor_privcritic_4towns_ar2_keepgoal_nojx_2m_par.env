# THE CLUSTER RUN ON FOUR TOWNS: SAC FROM c0, PRIVILEGED CRITIC, GOAL KEPT FIXED, NO SPAWN INSIDE A JUNCTION,
# ACTOR RELEASED AT 15,000, 2,000,000 DECISIONS (user 2026-11-14: "what about 4 town training - and distance
# travelled logged").
# = slurm/cluster_frl_c0actor_privcritic_t05t01_ar2_keepgoal_nojx_2m.env (lane cost 0.5, GOAL_KEEP_ON_PASS=1,
#   ORIGIN_NOT_IN_JUNCTION=1, freeze 15,000, replay 300,000, checkpoints every 25,000) with ONLY:
#   - ENV_TOWNS=Town05,Town01,Town04,Town10HD: the four training towns (never Town02 / Town03 / Town07);
#   - FRL_PARALLEL=1: every town's env stepped at once (torch_rl/frl/carla.train_parallel). Per transition it
#     is the same learner: one update per env step, the freeze and the entropy anneal count transitions.
#     The two-town sequential job ran at 8 decisions per second, which is 68 h for 2M.
# The [FRL] line of this code also logs goal_m / explore_m / m_per_fault: metres per goal episode, per
# explore episode and per fault end over the last 100 training episodes (torch_rl/frl/carla.Odometer).
. "$REPO/slurm/cluster_frl_c0actor_privcritic_t05t01_ar2_keepgoal_nojx_2m.env"
export ENV_TOWNS=Town05,Town01,Town04,Town10HD
export FRL_PARALLEL=1
