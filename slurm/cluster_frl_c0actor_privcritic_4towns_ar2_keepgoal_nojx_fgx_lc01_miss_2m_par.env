# THE FOUR-TOWN CLUSTER RUN WITH THE TWO REWARD CHANGES (user 2026-11-15: "ok. do it", twice: for the local
# run, then for the cluster after the local run held its release).
# = slurm/cluster_frl_c0actor_privcritic_4towns_ar2_keepgoal_nojx_fgx_2m_par.env (Town05, Town01, Town04,
#   Town10HD in parallel; goal kept fixed; no spawn in a junction; release at 15,000; another town's goal
#   image in explore; +100 at 200 m of explore; 2,000,000 decisions) with ONLY:
#   1. FRL_LANE_STEP_COST=0.1 instead of 0.5;
#   2. GOAL_MISS_END_M=10: a goal episode ends as "missed" once the car is 10 m further from the goal than
#      its closest (vae_nav.gated_reward).
# WHY: with 0.5 and no missed-goal ending, c0's own reward measured +0.09 a decision in explore and -0.28 in
# goal mode (Town01), the critic valued every state negative (-30 in Town01, about -170 over four towns)
# and both four-town runs fell from ~170 m to under 10 m per explore episode within 3,000 decisions of the
# release. The local Town01 run with these two changes (slurm/local_..._fgx_lc01_miss.env) measured +0.5
# and +1.4 to +3 a decision, a value of +37 at the release, and held: 16,000 decisions later 147 m per
# explore episode (c0 131), 208 m per fault (c0 199), goal success 0.77 (c0 0.73).
# The log of this code (a45dc6b) also prints r_net / r_lane per mode, so the four-town reward is measured.
export FRL_LANE_STEP_COST=${FRL_LANE_STEP_COST:-0.1}
. "$REPO/slurm/cluster_frl_c0actor_privcritic_4towns_ar2_keepgoal_nojx_fgx_2m_par.env"
export GOAL_MISS_END_M=10
