# SAC FROM c0 WITH THE CRITIC ON THE TRUE STATE, ON THE CLUSTER, TOWN05 + TOWN01 (user 2026-11-14: "if
# collapse does not happen - start on cluster").
# = slurm/local_frl_c0actor_privcritic_t01_ar2.env, the local Town01 run that held c0's level after the
#   actor was released (goal success 0.89-0.92 in training through 38,000 decisions), with ONLY:
#   - ENV_TOWNS=Town05,Town01: one env and one server per town, driven one at a time, the next town at
#     every episode end (torch_rl/frl/carla.train -- the SAME loop as the local run);
#   - the cluster's copy of c0's trunk;
#   - the budget: 300,000 decisions, checkpoints every 25,000, scored inside the job.
# Every learner and reward setting is the local run's.
export FRL_C0=$HOME/carla-rl/checkpoints/il_bc_c0/step_15000
export FRL_MAX_STEPS=${FRL_MAX_STEPS:-300000} FRL_CKPT_EVERY=${FRL_CKPT_EVERY:-25000}
export FRL_REPLAY=${FRL_REPLAY:-300000}
. "$REPO/slurm/local_frl_c0actor_privcritic_t01_ar2.env"
export ENV_TOWNS=Town05,Town01
export FRL_PARALLEL=0
export FRL_C0=$HOME/carla-rl/checkpoints/il_bc_c0/step_15000
