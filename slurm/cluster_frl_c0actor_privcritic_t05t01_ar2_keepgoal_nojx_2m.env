# THE CLUSTER RUN: SAC FROM c0, PRIVILEGED CRITIC, GOAL KEPT FIXED, NO SPAWN INSIDE A JUNCTION, ACTOR RELEASED
# AT 15,000, TOWN05 + TOWN01, 2,000,000 DECISIONS (user 2026-11-14: "ok restart train 2M and release at
# 15,000", "setup cluster run").
# = slurm/cluster_frl_c0actor_privcritic_t05t01_ar2.env (one env and one server per town, driven one at a
#   time; the SAME loop as the local runs; cluster copy of c0's trunk; checkpoints every 25,000; replay
#   300,000) with ONLY:
#   - FRL_LANE_STEP_COST=0.5, the local value. The parent's 0.1 collapsed locally after the release and
#     scored 5-10/80; 0.5 with the goal kept fixed scored 41/80 at 30,000 decisions and was still rising;
#   - GOAL_KEEP_ON_PASS=1 in training: a pass through the arrival radius above the speed limit no longer
#     draws a new goal (slurm/local_frl_c0actor_privcritic_t01_ar2_keepgoal.env has the finding);
#   - ORIGIN_NOT_IN_JUNCTION=1 in training (slurm/patch_rlib_origin_not_in_junction.py, applied to THIS
#     code tree's own copy of rlib_integration, not to the shared ~/carla-rl one);
#   - FRL_MAX_STEPS=2000000.
# FRL_ACTOR_FREEZE stays at the parent's 15,000. Scoring overlays set neither switch.
export FRL_LANE_STEP_COST=${FRL_LANE_STEP_COST:-0.5}
export FRL_MAX_STEPS=${FRL_MAX_STEPS:-2000000}
. "$REPO/slurm/cluster_frl_c0actor_privcritic_t05t01_ar2.env"
export GOAL_KEEP_ON_PASS=1 ORIGIN_NOT_IN_JUNCTION=1
