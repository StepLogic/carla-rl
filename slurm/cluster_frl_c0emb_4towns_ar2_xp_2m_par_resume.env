# RESUME the running Town05 + Town01 2M run with the parallel loop AND two more towns (user 2026-11-12: "if its
# good - then resume current run with new code"; "can we add more towns"). = slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par.env
# (Town05, Town01, Town04, Town10HD stepped at once; same learner, reward, expert replay, 2M budget) with:
#   - JUNCTION_RAMP_START=0.85: the junction-goal share the run had reached (not in a checkpoint);
#   - FRL_RESUME=<its checkpoint dir>, given at launch (the whole learner and the step count restored; a fresh
#     replay; updates resume once 1000 own rows are back). Town04 and Town10HD join mid-run from that step.
. "$REPO/slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par.env"
export JUNCTION_RAMP_START=0.85
