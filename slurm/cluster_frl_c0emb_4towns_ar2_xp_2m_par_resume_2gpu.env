# RESUME the Town05 + Town01 2M run (frl_c0emb_t05t01_ar2_xp_2m_l40) from its step_150000 checkpoint, on TWO L40s,
# with four towns stepped in parallel and the batched critic (user 2026-11-12: "Switch now from 150k").
# = slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par_resume.env (Town05, Town01, Town04, Town10HD in parallel, junction
# share 0.85, batched heads, same learner/reward/expert replay/2M budget) with the learner on its own GPU:
# CARLA renders on GPU 0, the trainer (learner, c0 trunk, DEBiT encoder, replay) runs on cuda:1 -- measured in
# smoke 466044 at ~8.6 steps/s with updates vs 6.0 for the run so far. FRL_RESUME is given at launch.
. "$REPO/slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par_resume.env"
export CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_DEVICE=cuda:1
export FRL_REPLAY_DEVICE=
