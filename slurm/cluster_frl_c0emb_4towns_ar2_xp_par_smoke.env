# 6000-step smoke of slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par.env: four servers and envs come up, all four
# step every iteration, the updates start at 1000 as in the run, and the speed with updates is measured
# (steps 1000-6000) before the 2M run. Only the run length changes.
. "$REPO/slurm/cluster_frl_c0emb_4towns_ar2_xp_2m_par.env"
export FRL_MAX_STEPS=6000 FRL_CKPT_EVERY=6000 FRL_LOG_EVERY=500
