# The 6000-step parallel smoke (slurm/cluster_frl_c0emb_4towns_ar2_xp_par_smoke.env) with the LEARNER ON ITS OWN
# GPU (job of 2 L40s): the CARLA servers render on GPU 0 (UE4's default adapter), the trainer -- learner, c0
# trunk, DEBiT encoder, replay -- runs on cuda:1. Measured on one shared L40 (job 465992): the four towns stepped
# at 22 steps/s without updates, but each update took ~0.09 s against 0.056 s with two servers on the GPU, so
# 7.2 steps/s with updates; the learner's many small kernels wait behind the renderers' time slices.
# CUDA_DEVICE_ORDER=PCI_BUS_ID keeps CUDA's numbering on the bus order Vulkan enumerates in.
. "$REPO/slurm/cluster_frl_c0emb_4towns_ar2_xp_par_smoke.env"
export CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_DEVICE=cuda:1
export FRL_REPLAY_DEVICE=
export FRL_BATCHED_HEADS=1        # the critic heads in one batched pass (same weights and numbers)
