# slurm/cluster_frl_c0emb_t05t01_ar2_xp.env run for 2M decisions instead of 250k (user 2026-11-11: "no increase
# it to 50M"; then, told 50M cannot finish in one 30-day job at the A100's ~4.6 steps/s, chose "Shorter long run:
# 2M" with evals every 250k, and "Keep FastRLAP's schedule" for the entropy target: it keeps falling by 2.5e-6 per
# step, to -6.0 at 2M). Every other setting unchanged, the 250k-row own replay included.
. "$REPO/slurm/cluster_frl_c0emb_t05t01_ar2_xp.env"
export FRL_MAX_STEPS=2000000
