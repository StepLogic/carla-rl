# RESUME the running Town05 + Town01 2M run (frl_c0emb_t05t01_ar2_xp_2m_l40) with the parallel loop (user
# 2026-11-12: "if its good - then resume current run with new code"). = slurm/cluster_frl_c0emb_t05t01_ar2_xp_2m.env
# (same towns, learner, reward, expert replay, 2M budget) with:
#   - FRL_PARALLEL=1: both towns stepped at once (train_parallel); per transition the learner is unchanged;
#   - FRL_REPLAY_DEVICE=cuda: the replay on the L40;
#   - JUNCTION_RAMP_START=0.85: the junction-goal share the run had reached (its [Ramp] lines: 0.85 by ~50k);
#     the ramp state is not in a checkpoint;
#   - FRL_RESUME=<its checkpoint dir>, given at launch: the whole learner and the step count restored, a fresh
#     replay (pinned expert rows + own rows from 0), updates resume once 1000 own rows are back.
. "$REPO/slurm/cluster_frl_c0emb_t05t01_ar2_xp_2m.env"
export FRL_PARALLEL=1 FRL_REPLAY_DEVICE=cuda
export JUNCTION_RAMP_START=0.85
