# SINGLE-TRACE EVALUATION MAPS, the trace (user 2026-11-06: "CAN YOU CREATE MAP
# FROM A SINGLE TRACE?" -> "I am talking about evaluations").
#
# WHAT. CARLA's BasicAgent drives ONE closed coverage tour of a held-out town --
# every driving lane at least once in its legal direction, no lane change -- in
# a single explore-mode episode, and the clone c0 rides along at every step for
# the entropy the online-MAD map is placed on (train_carla_sac.run_expert_trace).
# The Gibson protocol builds each scene's map from one continuous trace; v30's
# map trace was many short policy segments joined by respawns.
#
# BASE: c0's own eval overlay (MONO_CHW + SPEED_OBS, which c0 needs to load and
# see the right layout; v30's camera and env through il_expert.env), so the
# frames stored are exactly what c0 sees in the benchmark.
#
# ONE EPISODE. Every explore-mode end except a collision is lifted, because a
# trace scores nothing and each end would be a respawn:
#   GATED_EXPLORE_MAX_STEPS / MAX_EPISODE_STEPS  the explore cap and TimeLimit
#   EXPLORE_GOAL_DIST_M=0                        the 100 m explore "arrival"
#   EXPLORE_LANE_MODE=penalise                   crossings counted, not fatal
#   EXPLORE_OFF_ROAD_FATAL=0                     off-road counted, not fatal
#   STALL_TRUNCATE_STEPS=0                       run_expert_trace has its own stuck stop
# ROUTE_RETREAT_SCALE goes back to 1 because gated_reward refuses a discounted
# retreat when crossings are not terminal; that guard protects LEARNING, and
# here it changes only the recorded reward, which nothing reads.
#
# TRACE-ONLY. Never under il_data (torch_rl.expert_trace.trace_dir refuses it);
# the map-trace format is read by no training loader.
. "$REPO/slurm/il_eval_chw.env"
export EXPERT_TRACE=1 EVAL_FORCE_MODE=0
export GATED_EXPLORE_MAX_STEPS=400000 MAX_EPISODE_STEPS=400000 EXPLORE_GOAL_DIST_M=0
export EXPLORE_LANE_MODE=penalise EXPLORE_OFF_ROAD_FATAL=0 STALL_TRUNCATE_STEPS=0
unset ROUTE_PROGRESS_POSITIVE
export ROUTE_RETREAT_SCALE=1
export EXPERT_TRACE_ROOT=$HOME/carla-rl/checkpoints/trace_expert EXPERT_TRACE_CHUNK=2000
