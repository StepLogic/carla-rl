# The expert coverage tour that drives EVERY junction turn as well as every lane
# (user 2026-11-07, "make sure paths can be planned with MAP"). The lanes-only
# tour (expert_trace.env) left most turns undriven, so its maps planned 6-22x
# detours round the block for 15-45% of benchmark episodes. Separate root, so
# the lanes-only traces stay as they are.
. "$REPO/slurm/expert_trace.env"
export EXPERT_TOUR_JUNCTIONS=1
export EXPERT_TRACE_ROOT=$HOME/carla-rl/checkpoints/trace_expert_jx
