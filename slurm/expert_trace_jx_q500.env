# Run Q's own expert tour (user 2026-11-08: "ensure Run Q builds its own entropy
# map"): the junction-turn coverage tour of expert_trace_jx.env, driven by the same
# expert, with Run Q step_500000 riding along (TRACE_CLONE) so the recorded
# entropy is Q's. c0's entropy cannot be swapped offline: it read the env's goal
# inputs (binoc, goal tokens), which the trace does not store.
. "$REPO/slurm/expert_trace_jx.env"
export EXPERT_TRACE_ROOT=$HOME/carla-rl/checkpoints/trace_expert_jx_q500
