# TRAINING-TOWN coverage tours (plan 2026-11-09, A1): the same expert tour of every
# lane AND every junction turn as slurm/expert_trace_jx.env, for Town05 and Town01,
# so a multi-turn validation set and maps exist where decisions may be made (Town02/
# Town03 are evaluation towns: no decisions there). Separate root, so the held-out
# towns' traces stay as they are. Trace-only: nothing trains on it.
. "$REPO/slurm/expert_trace_jx.env"
export EXPERT_TRACE_ROOT=$HOME/carla-rl/checkpoints/trace_expert_jx_train
