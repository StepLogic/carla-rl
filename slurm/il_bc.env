# IMITATION-FIRST M2: behaviour cloning overlay (2026-11-04, plan Task 7).
# BC_TRAIN=1 makes train_carla_sac.py clone the recorded expert
# (torch_rl/bc_trainer.py) and return -- no simulator is started. The learner is
# built exactly as for SAC (build_agent), so the clone IS the fine-tune's start.
# The recorded episodes' rows are held in host RAM as uint8 frames: ~300k rows
# x 55 KB is about 17 GB, so the job asks for 160 GB.
. "$REPO/slurm/il_expert.env"
export BC_TRAIN=1 BC_DATA_ROOT=$HOME/carla-rl/checkpoints/il_data BC_UPDATES=20000 BC_CHUNKS=32 BC_LEN=40
export REPLAY_DEVICE=cpu REPLAY_U8=1
