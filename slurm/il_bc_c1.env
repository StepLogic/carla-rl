# B3 (plan 2026-11-09): clone c1 = c0's recipe (slurm/il_bc_chw.env: MONO_CHW, speed,
# BC_AUG, 15k updates of 32 chunks x 40) on M1 (il_data, ids <= 199999, as c0) PLUS
# the DAgger-in-chains round-1 shards (il_data_dagger_chain1) PLUS the map-subgoal
# shards (il_data_map1, B2). Only the data changes;
# it is chosen by BC_SHARD_LIST (written by slurm/il_bc_c1.sh), since the seed cap
# BC_MAX_SEED would drop the chain shards (ids seed*100+segment).
. "$REPO/slurm/il_bc_chw.env"
unset BC_MAX_SEED
export BC_SHARD_LIST=${BC_SHARD_LIST:?the shard list file}
