# IMITATION-FIRST, FIXED FRAME LAYOUT (user 2026-11-05, "option and proceed"):
# round-0 cloning from scratch on the expert's own episodes with the ResNet
# finally seeing the picture upright (MONO_CHW=1: the frame stored (3, s, s), the
# layout the learner reads), the car's speed in the observation (SPEED_OBS=1)
# and per-chunk photometric augmentation of the frames (BC_AUG=1: brightness
# +-0.4, contrast +-0.4, colour gain +-0.1) for Town03's tunnel and glare.
# 15k updates: augmentation tends to move the best checkpoint later.
. "$REPO/slurm/il_bc.env"
export SPEED_OBS=1 MONO_CHW=1 BC_AUG=1 BC_MAX_SEED=199999 BC_UPDATES=15000
