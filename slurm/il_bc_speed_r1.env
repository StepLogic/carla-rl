# IMITATION-FIRST, SPEED IN THE OBSERVATION, DAgger round 1 retraining
# (2026-11-05): continue cloning from speed round 0's selected checkpoint
# (il_bc_s0 step_7500: validation 0.750 true / 0.013 wrong) on ALL episodes --
# the expert's plus round 1's policy-driven, expert-labelled ones (stop-forever
# tails cut by stop_cut) -- with the car's speed in the observation, so the
# speed-dependent DAgger labels no longer contradict each other. 10k updates.
. "$REPO/slurm/il_bc.env"
export SPEED_OBS=1 BC_INIT_FROM=$HOME/carla-rl/checkpoints/il_bc_s0/step_7500 BC_UPDATES=10000
