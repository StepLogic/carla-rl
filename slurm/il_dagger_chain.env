# B1 (plan 2026-11-09): DAgger IN CHAINS. c0 drives (EXPERT_DRIVER=policy) chained
# goals placed 5-25 m past the next junction, to 200 m (EVAL_CHAIN, GOAL_CHAIN_*), in
# a training town; the expert labels every frame. Each goal segment is its own shard
# (EXPERT_RECORD_CHAIN); goal episodes only (EXPERT_GOAL_ONLY, even seeds). Rules as
# the evaluation: the junction off-road rule and arrival at any speed (c0 drives at
# ~14 km/h; the 10 km/h rule would stall every chain). c0's frame layout + speed.
. "$REPO/slurm/il_record.env"
export SPEED_OBS=1 MONO_CHW=1
export EVAL_CHAIN=1 GOAL_CHAIN_M=200 GOAL_CHAIN_STYLE=past_junction GOAL_CHAIN_MIN_M=5 GOAL_CHAIN_MAX_M=25
export EXPERT_RECORD_CHAIN=1 EXPERT_GOAL_ONLY=1
export OFF_ROAD_JUNCTION_M=3.5 GOAL_ARRIVAL_MAX_SPEED=0
