# IMITATION-FIRST: the held-out measurement overlay (2026-11-04, plan Task 8):
# Town02 and Town03, n=100, true goal and WRONG_GOAL_MODE=1, for the clone and
# every later stage. il_expert.env already removes the 200 m MAX_DISTANCE_M cap
# (which scored long drives as arrivals); GOAL_KEEP_ON_PASS=1 keeps the goal
# where the picture says it is (the env otherwise moves it when the car enters
# the 2 m circle too fast to count -- job 463139). Faults always end an eval
# episode in this trainer (_fault, train_carla_sac.py).
. "$REPO/slurm/il_expert.env"
export GOAL_KEEP_ON_PASS=1
