# IMITATION-FIRST CHAIN EVAL (plan Task 11): one car driven goal after goal, each
# 5-25 m ahead along the road (GOAL_CHAIN_STYLE=ahead), until 200 m are driven,
# a fault or the clock (EVAL_CHAIN=1, run_eval). Success bar: >= 50% of chains
# complete. il_eval.env underneath: eval fixes, goal held still, faults terminal.
. "$REPO/slurm/il_eval.env"
export EVAL_CHAIN=1 GOAL_CHAIN_M=200 GOAL_CHAIN_STYLE=ahead GOAL_CHAIN_MIN_M=5 GOAL_CHAIN_MAX_M=25
