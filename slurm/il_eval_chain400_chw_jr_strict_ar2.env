# 400 m CHAIN scoring at action repeat 2 under the slow-arrival rule (user 2026-11-14: "we need it to drive
# ~400m and explore ~400"): slurm/il_eval_chain_chw.env (goals 5-25 m ahead, chained) with the junction
# off-road rule, arrival counted only at <= 10 km/h, and the chain run to 400 m instead of 200.
. "$REPO/slurm/il_eval_chain_chw.env"
export OFF_ROAD_JUNCTION_M=3.5 GOAL_ARRIVAL_MAX_SPEED=10 ACTION_REPEAT=2 GOAL_CHAIN_M=400
