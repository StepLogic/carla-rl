# CHAIN EVAL for training-town validation (plan 2026-11-09, A3): the spec's chain
# metric -- one car driven goal after goal, 5-25 m AHEAD, until 200 m -- under the
# current rules: the junction off-road rule (OFF_ROAD_JUNCTION_M=3.5) and arrival at
# ANY speed (user 2026-11-09). c0's frame layout + speed via il_eval_chain_chw.env.
. "$REPO/slurm/il_eval_chain_chw.env"
export OFF_ROAD_JUNCTION_M=3.5 GOAL_ARRIVAL_MAX_SPEED=0
