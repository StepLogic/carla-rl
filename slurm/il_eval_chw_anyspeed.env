# The map-benchmark eval overlay with NO arrival speed condition (user 2026-11-09:
# "the only condition is the agent reaches the goal"): success = entering the
# 1 m goal radius at any speed. GOAL_ARRIVAL_MAX_SPEED=0 means no condition in
# both the env (gated_reward._stopped_enough) and the scorer
# (carla_benchmark.EpisodeTracker). It must come from an overlay: v52_reward.env
# sets 10 km/h after the command line is read.
. "$REPO/slurm/il_eval_chw.env"
export GOAL_ARRIVAL_MAX_SPEED=0
