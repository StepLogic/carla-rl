# IMITATION-FIRST: validation eval overlay for choosing the cloning checkpoint
# (2026-11-04, plan Task 7). Training towns only (Town05, Town01; EVAL_SEED=50000,
# away from the recording seeds 100000+), true goal and WRONG_GOAL_MODE=1.
# GOAL_KEEP_ON_PASS=1: the goal stays where the picture says it is; without it
# the env moves the goal whenever the car enters the 2 m circle too fast to
# count, which silently changes the task under the eval (job 463139).
# Faults always end an eval episode in this trainer (_fault, train_carla_sac.py).
. "$REPO/slurm/il_expert.env"
export GOAL_KEEP_ON_PASS=1
