# The validation eval (il_eval_val_chw.env) with the junction off-road rule on
# (user 2026-11-06: "use distance rule"; df58898): inside a junction an off-road
# reading counts only when the car's centre is more than 3.5 m from the nearest
# Driving-lane centre. c0's own off-road faults were mostly junction false
# positives (74 of 81 in junctions, 1.75-3 m from a lane centre). Used with
# VAL_TAG=jr35 so these results sit beside the old-rule ones, never over them.
. "$REPO/slurm/il_eval_val_chw.env"
export OFF_ROAD_JUNCTION_M=3.5
