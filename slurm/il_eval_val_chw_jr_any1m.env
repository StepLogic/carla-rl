# TRAINING-TOWN VALIDATION AT THE BENCHMARK'S RULES (plan 2026-11-09): c0's validation
# (Town05/Town01, EVAL_SEED 50000+, 40 per town) with the junction off-road rule
# (OFF_ROAD_JUNCTION_M=3.5, jr35) and the benchmark's success rule -- arrival within
# 1 m at ANY speed (user 2026-11-09). jr35nb + GOAL_RADIUS_M=1.0. (vint-carla's
# il_eval_val_chw_any1m.env is the same without the junction rule; different name on
# purpose.) A REWARD_OVERLAY, sourced after v52_reward.env, so the overrides hold.
. "$REPO/slurm/il_eval_val_chw_jr_nb.env"
export GOAL_RADIUS_M=1.0
