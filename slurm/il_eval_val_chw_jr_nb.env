# The junction-rule validation eval (il_eval_val_chw_jr.env) with NO arrival speed
# condition (user 2026-11-07: "drop the 5km/h rule"; the limit in force was 10
# km/h, v52_reward.env, raised from 5 on 2026-10-14). Arrival = entering the 2 m
# goal radius at any speed: the env (gated_reward._stopped_enough) and the eval's
# 2 m scoring (carla_benchmark.EpisodeTracker) both read 0 as no condition.
# Used with VAL_TAG=jr35nb so these results sit beside the earlier rules' ones.
. "$REPO/slurm/il_eval_val_chw_jr.env"
export GOAL_ARRIVAL_MAX_SPEED=0
