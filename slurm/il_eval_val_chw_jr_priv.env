# The junction-rule validation eval (il_eval_val_chw_jr.env) for PRIV_OBS=1
# checkpoints (privileged critic, run K): the rows must carry the two critic-only
# goal-distance columns to match the checkpoint's state width. The actor never
# reads them and evals leave them 'unknown', so the scoring is exactly jr35's --
# use VAL_TAG=jr35 and compare paired with c0's il_bc_c0_val_jr35_<Town>.
. "$REPO/slurm/il_eval_val_chw_jr.env"
export PRIV_OBS=1
