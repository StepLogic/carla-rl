# Validation at action repeat 2 with the ARRIVAL-SPEED CONDITION LIVE (user 2026-11-13: "train the RL model
# so it passes their strict rule"). = slurm/il_eval_val_chw_jr_any1m_ar2.env with GOAL_ARRIVAL_MAX_SPEED=10
# instead of 0, so the eval scores what the training reward now pays for.
# This is NOT the same as filtering finished any-speed episodes on their recorded speed: the condition also
# decides when the episode ENDS (src/vae_nav/gated_reward: "driving through the goal radius at speed is not
# arriving: the bonus is withheld and the episode continues, so the car must brake to collect it"), and
# carla_benchmark.EpisodeTracker takes the same GOAL_ARRIVAL_MAX_SPEED for its own arrival test. A post-hoc
# filter is a LOWER BOUND, because a policy that overshoots and comes back to stop is not counted by it.
# Everything else -- 1 m radius, deterministic actions, faults terminal, seeds, episode count -- is the
# any-speed overlay's, so the two columns differ in exactly one rule.
. "$REPO/slurm/il_eval_val_chw_jr_any1m_ar2.env"
export GOAL_ARRIVAL_MAX_SPEED=10
