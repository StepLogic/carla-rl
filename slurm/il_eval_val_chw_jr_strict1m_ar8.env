# Validation at ACTION REPEAT 8 with the arrival-speed condition live: the scoring rule of
# slurm/il_eval_val_chw_jr_strict1m_ar2.env (Town05/Town01, EVAL_SEED 50000+, 1 m radius, arrival counts
# only at <= 10 km/h, deterministic actions, faults terminal) at the decision rate of the control-stream run
# (slurm/local_frl_control_t05t01_ar8.env; user 2026-11-14: "ok use action repeat at 8"). A policy is
# scored at the rate it was trained at, as the k=2 and k=4 overlays do.
# MAX_EPISODE_STEPS counts DECISIONS (torch_rl/carla_env_build.build_env: TimeLimit sits outside
# ActionRepeat), so the time limit is 8x the k=1 overlay's in simulator ticks, as the k=2 overlay's is 2x.
# A time-out is therefore more lenient here; an arrival or a fault is not.
. "$REPO/slurm/il_eval_val_chw_jr_any1m.env"
export ACTION_REPEAT=8
export GOAL_ARRIVAL_MAX_SPEED=10
