# IMITATION-FIRST: the expert recording overlay (2026-11-04; design
# docs/superpowers/specs/2026-11-04-imitation-first-image-goal-design.md).
#
# v30's recipe for everything the env pays and shows, so recorded rewards are
# the ones the M5 fine-tune trains on. Two eval-rule fixes ride along: the
# 200 m MAX_DISTANCE_M cap no longer turns long drives into "arrivals".
# The expert drives at 15 km/h (user, 2026-11-04): the actor is not given its
# speed, so the clone copies the expert's, and 15 km/h matches v30's measured
# eval speed (~14 km/h) with a ~3 m no-brake coast to the 10 km/h arrival limit.
. "$REPO/slurm/v30_overlay.env"
export MAX_DISTANCE_M=1000000000
export GOAL_CAM_MATCH=1 GOAL_DIST_MIN=5 GOAL_DIST_MAX=25 JUNCTION_GOAL_FRAC=0.85
export EXPERT_TARGET_KMH=15 EXPERT_EXPLORE_MIN_M=100 EXPERT_EXPLORE_MAX_M=200 EXPERT_REPLAN_M=3
