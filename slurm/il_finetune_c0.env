# RL fine-tune of the fixed-layout clone (imitation-first plan, Task 11 Step 5).
# User 2026-11-05: one seed for now, on the 80 GB A100.
#
# Starts from il_bc_c0 step 15000, chosen by the Task 7 validation rule (pooled
# Town05+Town01, n=40 each, faults terminal: true .787, wrong .075).
# Before the first RL update the replay is filled with the recorded expert
# episodes under il_data (M1 + DAgger round 1) and the critic warms up for 5000
# updates with encoder, GRU and actor frozen; then one cloning step follows every
# RL update, at a weight fading 1.0 -> 0 over 10000 updates, with the photometric
# augmentation c0 was trained with (BC_AUG). Goals chain 5-25 m ahead to 200 m.
. "$REPO/slurm/il_expert.env"
# c0's observation: channels-first frame (MONO_CHW) and speed (SPEED_OBS).
export SPEED_OBS=1 MONO_CHW=1 BC_AUG=1
export HER=1 REPLAY_CAPACITY=1000000 REPLAY_DEVICE=cpu REPLAY_U8=1 DET_EPISODE_FRAC=0.15 VIDEO_EVERY=20
export INIT_FROM=$HOME/carla-rl/checkpoints/il_bc_c0/step_15000 LEARNING_STARTS=20000
export IL_PRELOAD_ROOT=$HOME/carla-rl/checkpoints/il_data IL_CRITIC_WARMUP_UPDATES=5000 IL_BC_WEIGHT0=1.0 IL_BC_DECAY_UPDATES=10000
export GOAL_CHAIN_M=200 GOAL_CHAIN_STYLE=ahead GOAL_CHAIN_MIN_M=5 GOAL_CHAIN_MAX_M=25
export STALL_TRUNCATE_STEPS=100 STALL_SPEED_KMH=0.5
# Four training towns at once, one CARLA server each (the 80 GB card holds them).
export ENV_TOWNS=Town01,Town04,Town05,Town10HD PARALLEL_TOWNS=1 SEED=0
