# The c0 fine-tune with an ONLINE FREEZE (user 2026-11-05, after job 463440).
#
# il_finetune_c0.env unfroze the clone at the first live RL update and the run
# collapsed (policy= 0.76 -> 0.10 within ~190 updates, goal Q climbing to 37-82
# as success fell to ~0 by step 206k), the cloning loss at full weight throughout.
# Here the first 1000 RL updates (~80k steps at one update per 80 transitions,
# about an hour) train the critic only, on the clone's own rollouts; then the
# encoder, GRU and actor unfreeze with the cloning weight at 1.0, fading as before.
. "$REPO/slurm/il_finetune_c0.env"
export IL_ONLINE_FREEZE_UPDATES=1000
