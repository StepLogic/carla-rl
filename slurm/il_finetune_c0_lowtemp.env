# Run C (user 2026-11-05): run A's settings (online freeze, trunk frozen) with the
# starting TEMPERATURE cut from the checkpoint's 0.1 to 0.001 -- one change from
# il_finetune_c0_trunk.env (job 463479).
#
# In 463479 the entropy bonus at 0.1 inflated c0's steering noise ~8x (log-std
# -2.23 -> ~-0.2) within ~90 updates of the unfreeze: the sampled training
# episodes turned sloppy (policy= .83 -> .08 by 63k steps) while the noise-free
# policy held near its old level. The temperature is learned from 0.001 on.
. "$REPO/slurm/il_finetune_c0_trunk.env"
export IL_ALPHA0=0.001
