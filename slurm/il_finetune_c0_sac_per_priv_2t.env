# Run K on TWO towns (user 2026-11-07: "L40 now, Town05 + Town01"): every 80 GB
# A100 was held by other users' 8-10 day jobs, and an L40 (46 GB) renders two
# Epic towns, not run K's four. Everything else is run K
# (slurm/il_finetune_c0_sac_per_priv.env: run I + PRIV_OBS=1, speed rule kept);
# the recorded preload still covers all four training towns (IL_PRELOAD_TOWNS
# default) -- only the live driving is Town05 + Town01, the validation towns.
# Not a one-change comparison with run I (four live towns).
. "$REPO/slurm/il_finetune_c0_sac_per_priv.env"
export ENV_TOWNS=Town05,Town01
