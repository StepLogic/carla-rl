# Run G (2026-11-06): run F (il_finetune_c0_sac_pin_dims.env) with the actor
# stepping on every 10th update only -- the one change. User: "keep pure sac -
# but update actor less frequently", then "Every 10".
#
# The critic trains on every update; the actor and the SAC temperature step on
# every 10th (TD3's delayed policy update). The cloning step goes with the
# actor step and its 10000-update fade counts actor steps, so per actor step
# the SAC term and the cloning weight are run F's (bc_trainer.il_bc_hook).
# Run F lost the clone within ~350 actor steps (step-50k eval 41 of 80 against
# c0's 63); G reaches 350 actor steps near step 113k, with 10x the critic
# training and env data per actor step, so the two compare at equal actor steps.
# User: replace run F with this run on its GPU.
. "$REPO/slurm/il_finetune_c0_sac_pin_dims.env"
export ACTOR_UPDATE_EVERY=10
