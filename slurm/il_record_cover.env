# COVERAGE RECORDING (user 2026-11-06, "PERTURB EXPERT MORE SO WE HAVE COVERAGE DATA").
#
# il_record.env plus bigger and SUSTAINED perturbations of the executed action, so
# the replay holds what really happens after off-distribution actions -- the
# evidence the critic lacked when the SAC fine-tunes chased its guesses. The
# LABEL stays the expert's clean action (DART), so the episodes also teach
# recovery. Values are my choice (2026-11-06), the M1 recording's in brackets:
#   steering i.i.d. noise per episode   0.2 / 0.4           [0 / 0.1 / 0.2]
#   throttle i.i.d. noise               0.2                 [none]
#   bursts                              2% per step, 5-15 steps (0.5-1.5 s),
#                                       |steer| 0.3-1.0, |throttle| 0-0.5,
#                                       random signs        [none]
# Written to its own root so every existing overlay's preload (il_data) is
# unchanged; seeds from 500000 (M1 100000+, DAgger r1 300000+).
. "$REPO/slurm/il_record.env"
export EXPERT_SIGMAS=0.2,0.4 EXPERT_THROTTLE_SIGMA=0.2
export EXPERT_BURST_PROB=0.02 EXPERT_BURST_STEPS=5,15 EXPERT_BURST_STEER=0.3,1.0 EXPERT_BURST_THROTTLE=0.0,0.5
export EXPERT_RECORD_EPISODES=120 EXPERT_RECORD_ROOT=$HOME/carla-rl/checkpoints/il_data_cover
