# B2 (plan 2026-11-09): MAP-SUBGOAL RECORDING (EXPERT_RECORD_MAP, see train_carla_sac.py).
# The expert (DART noise, as M1) drives goal episodes drawn 50-149 m along the road
# (bench_turns.env's band, the multi-turn validation set's) in a training town while
# the goal input is the next node image of that town's image map (EVAL_MAP_DIR, set by
# slurm/il_record_map.sh); one shard per leg. Rules as the multi-turn validation: 1 m
# arrival at any speed, the junction off-road rule. c0's frame layout + speed, as B1
# (the shards store raw frames either way).
. "$REPO/slurm/il_record.env"
export SPEED_OBS=1 MONO_CHW=1
export GOAL_DIST_MIN=50 GOAL_DIST_MAX=149 GOAL_DIST_STEP=1 GOAL_RADIUS_M=1.0
export EXPERT_RECORD_MAP=1 EXPERT_GOAL_ONLY=1
export OFF_ROAD_JUNCTION_M=3.5 GOAL_ARRIVAL_MAX_SPEED=0
