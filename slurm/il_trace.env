# IMITATION-FIRST: lane-keeping traces for the M3 measurement (2026-11-04,
# plan Task 8 Step 7). The clone drives EXPLORE episodes (EVAL_FORCE_MODE=0)
# with its deterministic action (TRACE_NOISE_SCALE=0) on held-out Town02 /
# Town03, every crossing, off-road or collision ending a segment, until 5 km
# or 90% coverage. scripts/trace_failure_stats.py turns the index into metres
# between failures and the mean speed it was driven at.
# Same trace settings as the published v30 baseline (trace_v30det_*: 31.7 m
# between failures on Town02 at 22.2 km/h), apart from the 5 km cap the plan
# asks for and il_eval.env's eval fixes.
. "$REPO/slurm/il_eval.env"
export EVAL_TRACE=1 EVAL_FORCE_MODE=0 TRACE_NOISE_SCALE=0 TRACE_END_ON_CROSSING=1
export TRACE_DIST_M=5000 TRACE_COVERAGE=0.90 TRACE_MAX_STEPS=60000 TRACE_SPACING_M=2.0
