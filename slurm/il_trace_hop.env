# THE EVALUATION-MAP TRACE the user asked for on 2026-11-06, in order: "NO drive
# with new policy" -> "c0 explores on its own" -> "Can we explicitly random
# actions at junctions" -> "Goal hop per junction" -> "but save observations and
# entropy".
#
# il_trace_step.env (c0's per-step deterministic explore trace, every 0.1 s step
# kept, no coverage stop, continuation at the nearest drivable waypoint) plus the
# hop: nearing a junction c0 is handed a goal image 10-30 m past a RANDOMLY
# chosen exit and drives it in goal mode with a fresh GRU, then explores again.
#
#   TRACE_HOPS=1            the schedule (torch_rl.junction_hops.HopSchedule)
#   GOAL_RELATCH_ON_MOVE=1  REQUIRED, and run_trace refuses the hop without it:
#                           the DEBiT wrapper latches the goal frame at reset, so
#                           without the relatch the hop would move the planner's
#                           goal and the camera while the policy still saw the OLD
#                           goal image. GOAL_RELATCH_MIN_M=1 is the default.
#   TRACE_SAVE_BINOC=1      "save observations": with the frame, mode bit, speed
#                           and action already kept, the DEBiT binoc vector is the
#                           last piece, so the row the policy saw can be rebuilt
#                           offline with no CARLA and no encoder.
#   GOAL_CHAIN_*            where the hop's goal goes: the chain's own rule
#                           (goal_chain.goal_past_next_junction), 10-30 m past the
#                           next junction, 60 m lookahead -- the numbers in
#                           memory eval-map-trace-is-c0-explore-with-junction-hops.
#                           GOAL_CHAIN_M is NOT set: the reward wrapper must not
#                           start chaining, only the trace hops.
#   TRACE_HOP_*             trigger 20 m before the junction, arrival 4 m (the
#                           goal is a camera pose on the lane, not a parking spot),
#                           abandoned 15 m past the closest approach, 600 steps max.
#
# NOT CHANGED, on purpose: TARGET_SPEED, as in il_trace_step.env -- the 10 km/h
# trace rule would change the speed feature c0 sees; the user's call.
. "$REPO/slurm/il_trace_step.env"
export TRACE_HOPS=1 TRACE_SAVE_BINOC=1 GOAL_RELATCH_ON_MOVE=1
export GOAL_CHAIN_STYLE=past_junction GOAL_CHAIN_MIN_M=10 GOAL_CHAIN_MAX_M=30
export GOAL_CHAIN_LOOKAHEAD_M=60
export TRACE_HOP_TRIGGER_M=20 TRACE_HOP_ARRIVAL_M=4 TRACE_HOP_MISS_M=15
export TRACE_HOP_MAX_STEPS=600 TRACE_HOP_PENDING_STEPS=20
