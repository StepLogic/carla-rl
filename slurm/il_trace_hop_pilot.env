# PREFLIGHT for the junction-hop trace (user rule: confirm the recipe on a short
# run before a long one). il_trace_hop_Town02.env with a 400 m budget: enough for
# several junctions on Town02, so the log's [TraceHops] line and the first
# segment's npz prove the hop fires, the goal view re-latches, the mode bit and
# the explore entropy are recorded, and the binoc column is there -- before 8 km
# and 30 km are spent on it.
. "$REPO/slurm/il_trace_hop_Town02.env"
export TRACE_DIST_M=400
