# THE EVALUATION-MAP TRACE AS ONE UNBROKEN DRIVE (user 2026-11-06, in order:
# "NO drive with new policy" -> "c0 explores on its own" -> "Goal hop per
# junction" -> "but save observations and entropy" -> "i want one unbroke drive"
# -> "Expert recovers"). train_carla_sac.run_unbroken_trace.
#
# il_trace_hop.env (c0, deterministic explore, junction hops, every step, binoc,
# GOAL_RELATCH_ON_MOVE=1) plus:
#   TRACE_UNBROKEN=1              ONE episode; the car is never moved. At a fault
#                                 the expert recovers where the car is and hands
#                                 back to c0 (torch_rl.recovery.RecoveryGate).
#   every explore-mode END lifted, as slurm/expert_trace.env lifts them for the
#   expert's one-episode tour, and collisions too:
#     GATED_EXPLORE_MAX_STEPS / MAX_EPISODE_STEPS   the explore cap and TimeLimit
#     EXPLORE_GOAL_DIST_M=0                         the 100 m explore "arrival"
#     EXPLORE_LANE_MODE=penalise                    crossings counted, not fatal
#     EXPLORE_OFF_ROAD_FATAL=0                      off-road counted, not fatal
#     EXPLORE_COLLISION_FATAL=0 EXPLORE_COLLISION_TERMINAL=0   a crash does not
#                                 end the episode (run_unbroken_trace refuses to
#                                 start without the second)
#     STALL_TRUNCATE_STEPS=0      standing still is a FAULT the expert recovers
#                                 from (TRACE_STALL_STEPS), not an end
#   ROUTE_RETREAT_SCALE=1, unset ROUTE_PROGRESS_POSITIVE: gated_reward refuses a
#   discounted retreat when crossings are not terminal; only the recorded reward
#   changes, which nothing reads.
#   EXPERT_TARGET_KMH=15          the expert's recovery speed (its default)
# TRACE-ONLY: a crash that does not end the episode is not a training task.
. "$REPO/slurm/il_trace_hop.env"
export TRACE_UNBROKEN=1
export GATED_EXPLORE_MAX_STEPS=400000 MAX_EPISODE_STEPS=400000 EXPLORE_GOAL_DIST_M=0
export EXPLORE_LANE_MODE=penalise EXPLORE_OFF_ROAD_FATAL=0 STALL_TRUNCATE_STEPS=0
export EXPLORE_COLLISION_FATAL=0 EXPLORE_COLLISION_TERMINAL=0
unset ROUTE_PROGRESS_POSITIVE
export ROUTE_RETREAT_SCALE=1
export EXPERT_TARGET_KMH=15
