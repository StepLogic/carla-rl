# CLOSED-LOOP LANE DIAGNOSTIC, EASY BAND (development set only): as
# lanedbg_medium.env on the frozen easy band (goals 10-24 m, inside ViNT's
# training goal range of ~22 m; medium/hard goals are beyond it by design --
# ViNT reaches them through its topological map). The 1e-9 lane-centre weight
# only makes the env emit its lane state for EVAL_LANE_DEBUG.
. "$REPO/slurm/bench_easy.env"
export LANE_CENTRE_K=1e-9
