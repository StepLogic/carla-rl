# CLOSED-LOOP LANE DIAGNOSTIC (development set only, never the fresh set;
# 2026-11-07 "can we fix it?"): the frozen medium band, plus a 1e-9 lane-centre
# shaping weight. The env emits its lane state (info["lane_priv"]: offset, lane
# width, heading error) only when lane geometry is on (core_state.LANE_GEOM), and
# EVAL_LANE_DEBUG=1 prints it. The weight changes only the reward VALUE
# (gated_reward: no effect on termination or on any end); neither ViNT nor c0
# reads reward, so the driving is the benchmark's.
. "$REPO/slurm/bench_medium.env"
export LANE_CENTRE_K=1e-9
