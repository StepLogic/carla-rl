# LOCAL run (2026-11-08, user: "Fine-tune c0 locally, watch it", "town05 is what we
# will start with", "run carla on host", "use torch compile", then "i want standard
# SAC - logstd is learned and temperature is auto adjusted"): the RTX 4070 with the
# host CARLA 0.9.15, windowed (no container), Town05 only -- run via
# ~/carla-sac-local/run_c0ft_local.sh, which sets the host paths and TORCH_COMPILE=1.
#
# Recipe = run S2 (slurm/sac_c0_trunk_a02_demos.env: from c0 with the encoder and GRU
# frozen, c0's Town05 demos preloaded and PINNED with the arrival approach cut, HER,
# arrival at any speed, one update per 5 env steps, critic warm-up 5000 updates on the
# demos, actor frozen for the first 5000 online updates) as STANDARD SAC: the actor
# learns its own log-std and the temperature is auto-tuned toward the target entropy
# (-2, at LR) -- FIXED_ALPHA and any log-std pin are cleared. The temperature starts
# at the value stored in c0's checkpoint, 0.1 (a clone never trains it).
# One town and the host's CARLA 0.9.15 (c0 learned on 0.9.16) differ from the
# cluster runs; with one town, one update per 5 steps is 64 replayed samples per new
# transition (the two-town cluster runs: 32).
. "$REPO/slurm/sac_c0_trunk_a02_demos.env"
unset FIXED_ALPHA ACTOR_LOG_STD
L=/home/robotlab/carla-sac-local/checkpoints
export INIT_FROM=$L/il_bc_c0/step_15000 IL_PRELOAD_ROOT=$L/il_data IL_PRELOAD_TOWNS=Town05
export ENV_TOWNS=Town05 PARALLEL_TOWNS=1
# SMOKE=1: a few minutes through every phase (preload + pin, critic warm-up, c0
# driving, critic-only updates, actor release) -- plumbing only, never a result.
if [ "${SMOKE:-0}" = 1 ]; then
  export MAX_STEPS=3000 LEARNING_STARTS=500 IL_CRITIC_WARMUP_UPDATES=100
  export IL_ONLINE_FREEZE_UPDATES=100 CKPT_EVERY=1000000
fi
