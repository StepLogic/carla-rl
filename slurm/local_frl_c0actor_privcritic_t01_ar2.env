# SAC FROM c0, WITH THE CRITIC ON THE TRUE STATE (user 2026-11-14: "I want the SAC to have similar
# performance as c0", "lets try priveledge critic with per steering and lane error", "images go to only
# actor", "add goal and current location etc to critic input", "use c0 as actor").
# = slurm/local_frl_c0emb_t01_ar2.env (learner C on c0's frozen DEBiT-based trunk, Town01, action repeat 2,
#   no expert rows) with:
#   1. FRL_ACTOR=c0: the SAC actor is a trainable copy of c0's own head, so the run STARTS as c0;
#   2. FRL_PRIV_CRITIC=1 (+ OBS_PRIV=1 so the env reports the lane geometry): the critic reads no image
#      features, only the true state (lane offset, heading, edges, junction, speed, mode, the goal's
#      position in the car's frame, zero in explore). The actor reads images only, as c0 does;
#   3. FRL_LANE_STEP_COST=0.5: reward -= 0.5 x ticks x (|offset m| + |heading deg| / 10) per decision.
#      NOT potential-based on purpose. THIS CHANGES THE TRAINING REWARD; scoring is unchanged;
#   4. GOAL_ARRIVAL_MAX_SPEED=10: the slow-arrival rule;
#   5. the handover protected: FRL_ACTOR_FREEZE decisions of critic-only updates on c0's own rollouts
#      before the actor may move, and FRL_RANDOM_START=0 so c0 drives from the first step.
# WHY: offline on c0's recorded driving, a critic on image features preferred steering unrelated to the
# expert's (full lock in 52% of states); on the true state with this cost it preferred corrective steering
# (81% sign agreement with the expert where the expert steers), steered toward the goal and braked for it.
_frl_steps=${FRL_MAX_STEPS:-60000}; _frl_ckpt=${FRL_CKPT_EVERY:-10000}; _frl_replay=${FRL_REPLAY:-60000}
_frl_freeze=${FRL_ACTOR_FREEZE:-15000}
. "$REPO/slurm/local_frl_c0emb_t01_ar2.env"
export OBS_PRIV=1
export FRL_ACTOR=c0 FRL_PRIV_CRITIC=1 FRL_LANE_STEP_COST=${FRL_LANE_STEP_COST:-0.5}
export GOAL_ARRIVAL_MAX_SPEED=10
export FRL_ACTOR_FREEZE=$_frl_freeze FRL_RANDOM_START=0
export FRL_MAX_STEPS=$_frl_steps FRL_CKPT_EVERY=$_frl_ckpt
export FRL_REPLAY=$_frl_replay FRL_REPLAY_DEVICE=${FRL_REPLAY_DEVICE:-cpu}
