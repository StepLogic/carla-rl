# THE LOCAL SAC-FROM-c0 RUN, RESTARTED FROM ITS OWN WEIGHTS WITH THE LANE COST AT 0.1 (user 2026-11-14,
# after seeing the reward: "ok lets proceed", "restart with current weights locally and monitor").
# = slurm/local_frl_c0actor_privcritic_t01_ar2.env with:
#   - FRL_LANE_STEP_COST=0.1 instead of 0.5, and no heading charge inside junctions
#     (torch_rl/frl/carla.lane_step_cost). At 0.5 the cost equalled the progress reward on an ordinary
#     decision: the run rose to goal success 0.95 at 40,000 decisions, then slid to 0.82 by 50,000 through
#     slow driving, time-outs and stalls, not lane faults;
#   - FRL_RESUME (given at launch): the whole learner from that run's checkpoint. The replay is not in a
#     checkpoint, so it starts empty and updates resume once 1,000 new decisions are in it;
#   - FRL_PARALLEL=1 on the one town: only that loop restores a checkpoint (the one-env loop ignores
#     FRL_RESUME); per transition it is the same learner.
# The critic resumes with values learned under the 0.5 cost and has to re-fit to 0.1.
export FRL_LANE_STEP_COST=${FRL_LANE_STEP_COST:-0.1}
export FRL_MAX_STEPS=${FRL_MAX_STEPS:-100000}
. "$REPO/slurm/local_frl_c0actor_privcritic_t01_ar2.env"
export FRL_PARALLEL=1
