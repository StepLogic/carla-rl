# LEARNER C, LOCAL, TOWN01, ACTION REPEAT 2 + c0's EXPERT ROWS PINNED IN THE MAIN REPLAY (user 2026-11-11:
# "ok add expert data"; 2026-11-10: "ok - restart run with expert pinned in buffer", "use existing data not
# new data").
# = slurm/local_frl_c0emb_t01_ar2_x.env -- the same expert replay (c0_m1_t01t05_k2.npz, 94,947 transitions,
# rewards relabelled to this run's reward, no_arrival cut) -- but the expert rows sit in the RL's OWN replay
# instead of FastRLAP's second update: never overwritten, sampled uniformly together with the RL's own rows
# (no forced share), one update per step, and the temperature tuned on the RL's own rows only (the
# prerecorded-data rule). torch_rl/frl/carla.FeatureReplay(pinned=...).
. "$REPO/slurm/local_frl_c0emb_t01_ar2_x.env"
export FRL_EXPERT_MODE=pinned
