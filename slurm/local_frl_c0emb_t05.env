# LEARNER C in CARLA, LOCAL (user 2026-11-10: "Compressed to 50-d, compression trained by the
# critic (FastRLAP)", "proceed build it and run locally", "move straight to learner C").
# Task env = C1's k=1 control (slurm/sac_scratch_ar1.env: P2's task -- off-road terminal with the
# 3.5 m junction rule, idle charge, arrival at any speed, the junction curriculum -- under the
# plain-SAC rule) on ONE town, Town05: the local RTX 4070 holds one Epic server.
# Learner and loop: torch_rl/frl/carla.py (FastRLAP's redq settings and online loop) on c0's
# frozen trunk; the FRL_* below default so a launcher can shorten them for a smoke run.
# The old loop's settings in the chain (HER, noise-free episodes, LEARNING_STARTS, UPDATE_EVERY,
# replay sizes) are never read by learner C's loop.
. "$REPO/slurm/sac_scratch_ar1.env"
export ENV_TOWNS=Town05 PARALLEL_TOWNS=0 LEARNER=frl
# learner C's loop has neither (torch_rl.frl.carla.frl_refusals refuses them on, rather than
# ignoring them silently): no hindsight relabelling, no noise-free episodes
export HER=0 DET_EPISODE_FRAC=0
export FRL_C0=${FRL_C0:-/home/robotlab/carla-sac-local/checkpoints/il_bc_c0/step_15000}
export FRL_PROBE_CACHE=${FRL_PROBE_CACHE:-/home/robotlab/carla-sac-local/checkpoints/encoder_probe_2026-11-09/features_Town05.npz}
export FRL_MAX_STEPS=${FRL_MAX_STEPS:-100000} FRL_CKPT_EVERY=${FRL_CKPT_EVERY:-25000}
export FRL_LOG_EVERY=${FRL_LOG_EVERY:-1000} FRL_START_TRAINING=${FRL_START_TRAINING:-1000}
