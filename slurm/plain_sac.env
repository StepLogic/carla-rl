# PLAIN SAC -- USER RULE 2026-11-08: "record these plain SAC RULES SO THAT NO NEW RUN IS
# WRONG". Earlier that day: "i want standard SAC - logstd is learned and temperature is
# auto adjusted"; "1) remove value clips 2) remove actor normalization - i want
# implementation to plain SAC 3) multiply reward in environment"; "no hacks or
# normalisations that were not present in plain SAC or REDQ or DrQ"; and, after the
# review, no pre-tanh penalty, no PER, every transition equally likely, no forced 50/50
# goal/explore batches.
#
# SOURCE THIS LAST in every SAC training overlay:  . "$REPO/slurm/plain_sac.env"
# train_carla_sac.py refuses to start a SAC training run that breaks any of these
# (require_plain_sac, tests/test_plain_sac_rule.py). Evals, traces, recordings,
# behaviour cloning and ALGO=iql are not SAC training and are exempt.
#
# The learner is then SAC with REDQ's ensemble: 10 critics, target = min over a random 2,
# MSE loss, tanh-Gaussian actor with learned log-std, auto-tuned temperature (target
# entropy -|A|), Polyak 0.005, uniform replay. A reward scale, if any, is applied only in
# the ENVIRONMENT (REWARD_SCALE, torch_rl/reward_scale.py); the learner scales nothing.
# CRITIC_LAYERNORM=1 is its own user rule (2026-11-06).
unset FIXED_ALPHA ACTOR_LOG_STD
export TQC_VALUE_FLOOR=none TQC_VALUE_CEILING=none
export EXPLORE_VALUE_FLOOR=none EXPLORE_VALUE_CEILING=none
export ACTOR_Q_NORM=0 ACTOR_PRETANH_L2=0 ACTOR_BC_ALPHA=0 IL_BC_WEIGHT0=0
export PER_ALPHA=0 UNIFORM_TRANSITIONS=1 GOAL_BATCH_FRAC=none IL_EXPERT_FRAC=0
export ONE_CRITIC=1 CRITIC_DROPOUT=0 CRITIC_LAYERNORM=1
