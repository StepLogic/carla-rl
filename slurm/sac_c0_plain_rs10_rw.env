# CLUSTER run, for when the local random-warm-up run passes its go/no-go bar (user:
# "if the local run looks good - start on cluster"; "Random warm-up ... Local first,
# same go/no-go bar, then the cluster"): slurm/sac_c0_plain_rs10.env (the local plain
# fine-tune of c0 on Town05 + Town01, demos of those two towns, in-job evals) with
# plain SAC's uniform-random start steps on the warm start (RANDOM_WARMUP=1), exactly as
# slurm/local_c0ft_t05_sac_plain_rw.env does locally.
. "$REPO/slurm/sac_c0_plain_rs10.env"
export RANDOM_WARMUP=1
