# CLUSTER run (2026-11-09; user, after job 465314's actor collapsed when it was released at
# 45k: "Ok start train with actor imeddiatle fine tuning starts"): slurm/sac_c0_sac2_projbc.env
# with the actor fine-tuned from the FIRST update -- no critic-only online phase
# (IL_ONLINE_FREEZE_UPDATES=0): actor and critic update together, as in standard SAC.
# Unchanged: the 20k uniform-random start steps (no update before 20k transitions), the
# 5000-update critic warm-up on the demos before any online step, the critic's 50-d head
# pretrained by imitation (10k updates) and frozen, standard SAC's twin critics with min,
# plain SAC (slurm/plain_sac.env), rewards x10 in the env, Town05 + Town01, in-job evals.
. "$REPO/slurm/sac_c0_sac2_projbc.env"
export IL_ONLINE_FREEZE_UPDATES=0
