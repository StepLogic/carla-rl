# Run S2 (2026-11-08, user: "the buffer should contain expert demonstrations too",
# then "Cut the arrival approach"): run S (slurm/sac_c0_trunk_a02.env: from c0 with
# the encoder and GRU frozen, run Q's recipe -- alpha fixed 0.02, HER, arrival at any
# speed, update every 5 steps, Town05 + Town01) with c0's recorded expert
# demonstrations PRELOADED into the replay.
#
# The demos (checkpoints/il_data, all four recorded towns) are PINNED: never
# overwritten and never update the temperature (user rule 2026-11-07; the temperature
# is fixed here anyway). IL_PRELOAD_TRANSFORM=no_arrival drops the last 30 steps
# before each recorded arrival and its +100 (those episodes count as cut off): the
# recorded expert braked to a stop for the 10 km/h rule, and a critic fitted on that
# credited "less throttle" for the +100 -- the slope behind every collapsed fine-tune;
# the slope diagnosis showed this cut flattens it. No cloning loss (IL_BC_WEIGHT0=0).
# The critic warms up for 5000 updates on the demos with everything else frozen;
# then the actor stays frozen for the first 5000 online updates
# (IL_ONLINE_FREEZE_UPDATES from run S), on c0's own driving.
. "$REPO/slurm/sac_c0_trunk_a02.env"
export IL_PRELOAD_ROOT=$HOME/carla-rl/checkpoints/il_data IL_PRELOAD_TRANSFORM=no_arrival
export IL_CRITIC_WARMUP_UPDATES=5000 IL_BC_WEIGHT0=0
