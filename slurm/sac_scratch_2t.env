# Run M (2026-11-07, user: "train SAC from scratch", "no pretraining"): run I's SAC
# (slurm/il_finetune_c0_sac_per.env: SAC + PER alpha .6, LayerNorm critic, REDQ
# 10/2, HER, goals chained 5-25 m to 200 m, the 10 km/h arrival rule, stall
# truncation) with NO pretraining of any kind:
#   * no clone init (INIT_FROM) -- the actor, critic and GRU start random; the
#     monocular trunk starts from DEBiT's pretrained weights and trains, the
#     encoder setup fixed by the user (2026-10-14), as in every from-scratch arm;
#   * no recorded data: no replay preload, no critic warm-up, no cloning;
#   * LEARNING_STARTS back to the default (random actions first).
# Image-only critic (PRIV_OBS off: privileged signals stay out of the main
# result, user rule 2026-11-07) and standard SAC temperature (target -2, ALPHA_LR
# 0 = the critic's 3e-4). Town05 + Town01 live, one L40 (the 80 GB A100s were all
# held by other users' jobs), as runs K and L.
. "$REPO/slurm/il_finetune_c0_sac_per.env"
unset INIT_FROM IL_PRELOAD_ROOT IL_CRITIC_WARMUP_UPDATES IL_BC_WEIGHT0 IL_BC_DECAY_UPDATES \
      IL_FREEZE_TRUNK IL_ONLINE_FREEZE_UPDATES BC_AUG LEARNING_STARTS ACTOR_LOG_STD \
      ACTOR_BC_ALPHA ACTOR_UPDATE_EVERY PRIV_OBS ALPHA_LR
export ENV_TOWNS=Town05,Town01
