# C1 (plan 2026-11-09): plain SAC from scratch with DrQ's action repeat, k = 4.
# P2's task (slurm/sac_scratch_2t_u5_orterm_idle_nb.env: Town05 + Town01, update every
# 5 transitions, off-road terminal with the 3.5 m junction rule, idle charge, arrival
# at any speed) under the plain-SAC rule, sourced LAST. k = 1 is the control; k = 2
# and 4 test whether the critic learns HOW MUCH to steer once one action spans k
# ticks (Gate C). Evals must use the same k: EVAL_VARIANTS with
# slurm/il_eval_val_chw_jr_any1m_ar4.env.
. "$REPO/slurm/sac_scratch_2t_u5_orterm_idle_nb.env"
export ACTION_REPEAT=4
. "$REPO/slurm/plain_sac.env"
