# v18 OVERLAY = everything in v16_overlay.env (junction goals, actor output
# penalty, crossing fine 20, lane potential 4/2, LayerNorm+tanh encoder head)
# + a higher standing-still cost. Sourced after v52_reward.env.
. "$REPO/slurm/v16_overlay.env"

# 5. IDLE COST 0.5 -> 2.0 per step below 2 km/h, both modes (reward; user's
#    choice 2026-10-27, "Raise idle cost, restart"). v17 -- encoder alive --
#    cut crossings to 7/40 on Town05 (13-27 in every earlier run) but PARKED
#    at the start in 24/40 Town02 and 22/40 Town05 evals at 500k (0.0 m in
#    1000 steps), up from 10 at 400k. With the crossing fine at 20, sitting
#    still at 0.5/step looked safer than a few risky metres. At 2.0 a parked
#    episode costs ~ -200 over the critic's ~100-step horizon, ten crossings'
#    worth. Arrival (<= 10 km/h) is above the 2 km/h idle line, so slowing to
#    arrive stays free.
export EXPLORE_IDLE_PENALTY=2.0
