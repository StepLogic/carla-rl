# v23 OVERLAY (user 2026-10-29: "all lane crossings should be terminal, and be
# value of 5, keep lane crossing, collision and off road same penalty").
# Sourced after v52_reward.env; starts from v22's recipe (two-action space,
# automatic arrival, junction goals 0.85, live encoder, idle 2.0).
. "$REPO/slurm/v22_overlay.env"

# 10. ONE PRICE FOR EVERY FAULT, AND CROSSINGS END THE EPISODE.
#
#     v22b at 1M ended 24 of 40 Town02 episodes OFF-ROAD with only 5 crossings:
#     a crossing cost 20 and ended nothing, off-road cost 10 a step and ended
#     nothing, and off the road there are no painted lines at all -- so leaving
#     the road was the cheap way to stop paying the lane bill.
#     Now a crossing, a collision and going off-road all cost 5, and a crossing
#     ends the episode as a collision already does.
export EXPLORE_LANE_MODE=terminal
export LANE_DEPARTURE_PENALTY=5.0
export LANE_COLLISION_PENALTY=5.0
export EXPLORE_OFF_ROAD_PENALTY=5.0
export EXPLORE_LANE_PENALTY_NONE=5.0

# NO LANE-CENTRE PULL (user 2026-10-29: "remove center pull"). The shaping is
# off, so nothing prices distance from the centre or heading error: the only
# lane term left is the crossing itself, which now ends the episode.
export LANE_CENTRE_K=0 LANE_HEADING_K=0
