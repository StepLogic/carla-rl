# v24 OVERLAY (user 2026-10-29: "make offroad and crossings all terminal").
# Sourced after v52_reward.env; starts from v23 (every fault priced at 5,
# crossings terminal, no lane-centre pull, junction goals 0.85, live encoder).
. "$REPO/slurm/v23_overlay.env"

# 11. OFF-ROAD ENDS THE EPISODE TOO.
#
#     v23 made crossings terminal and off-road fell from 24 of 40 Town02
#     episodes to 12, but it stayed the second failure: off-road cost 5 a step
#     and ended nothing, so driving off the road was still survivable. Now all
#     three faults -- crossing, collision, off-road -- cost 5 AND end the
#     episode. Nothing is survivable, and the only way to keep earning is to
#     stay on the road, in lane, and reach the goal.
export EXPLORE_OFF_ROAD_FATAL=1
