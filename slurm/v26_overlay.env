# v26 OVERLAY (user 2026-10-30, after nisheeth-golakiya/carla-rl: "i want it to
# follow lanes and navigate to goal"; "lane invasion ends navigation"; "remove
# idling"; explore "reward stays same as goal mode ... each step pays same").
#
# The repo's reward pays the distance driven each step and gives -1 AND ENDS
# THE EPISODE on a lane change. It survives that rule because its task is only
# lane following: every metre of correct driving pays, and nothing ever asks
# the car to cross a line. Here BOTH modes are paid the same thing -- metres
# along the road towards the episode's target -- and every fault costs 1 and
# ends the episode.
#
# Starts from v22 (the original two-action space, 85% junction goals, the v18
# terms) and replaces its reward.
. "$REPO/slurm/v22_overlay.env"

# 1. ABSOLUTE ACTIONS, stated rather than inherited: v25's incremental control
#    let the car sit at zero throttle, and 39/40 of its 200k eval episodes
#    parked at 0.0 m.
export INCREMENTAL_ACTIONS=0 MAX_STEER=1.0 MAX_THROTTLE=1.0

# 2. EVERY FAULT COSTS 1 AND ENDS THE EPISODE (the repo's -1, terminal).
export EXPLORE_LANE_MODE=terminal EXPLORE_OFF_ROAD_FATAL=1
export LANE_DEPARTURE_PENALTY=1.0 LANE_COLLISION_PENALTY=1.0
export EXPLORE_OFF_ROAD_PENALTY=1.0 EXPLORE_LANE_PENALTY_NONE=1.0

# 3. NO IDLE TERM ("remove idling"), and no lane-centre pull (the repo has
#    neither).
export EXPLORE_IDLE_PENALTY=0
export LANE_CENTRE_K=0 LANE_HEADING_K=0

# 4. GOAL EPISODES: paid each metre of ROUTE progress towards the goal (the
#    route-planner distance, POTENTIAL_K=1) and nothing else for driving --
#    explore's forward-progress term paid a car going down the wrong branch.
#    +100 on arrival, about four times what driving the whole route pays.
export GOAL_ROUTE_ONLY=1 POTENTIAL_K=1
export GOAL_EXPLORE_ARRIVAL_BONUS=100

# 5. EXPLORE EPISODES: the target is THE NEXT JUNCTION AHEAD, ANY EXIT. No goal
#    image is shown, so a specific junction would be invisible to the policy.
#    Forward road progress pays every metre towards it (1 per metre, the same
#    price as goal mode), clearing it pays +10, and the next junction becomes
#    the target. No 100 m arrival: the episode ends on a fault or the clock.
#    The bonus stays well below the goal's ("keep the bonus different",
#    user 2026-10-05) or goal episodes learn to collect junctions instead.
export EXPLORE_JUNCTION_BONUS=10
export EXPLORE_JUNCTION_MIN_STEPS=5 EXPLORE_JUNCTION_MIN_GAP_M=10
export EXPLORE_GOAL_DIST_M=0
