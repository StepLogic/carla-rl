# v31 OVERLAY (user 2026-11-01: "i want maximum learning", "should we use a
# lower learner rate", "i want REDQ and DroQ style setup for critics").
#
# THE REWARD IS v30'S, UNCHANGED -- this run changes the LEARNER only, so the
# comparison with v30 is clean.
. "$REPO/slurm/v30_overlay.env"

# EVERY-STEP UPDATES: 160 replayed samples per new transition, against v30's 8
# (1 update of 8x40 per vec step over 2 envs).
export UPDATE_EVERY=1 UPDATES_PER=1

# THE RATES THAT A 20x REPLAY RATIO NEEDS.
#   LR 3e-4 -> 1e-4: the critic and actor would otherwise move 20x further per
#   transition at the old rate.
#   ALPHA_LR 1e-5: the temperature falls with gradient STEPS, not env steps. v30
#   took 650k steps for alpha 0.075 -> 0.0005; at 20x that arrives by ~30k and
#   exploration is over before the first checkpoint.
export LR=1e-4 ALPHA_LR=1e-5

# DroQ. REDQ (10 critics, target = min over a random subset of 2) was ALREADY
# here -- the run banner says so. These two are the missing half: dropout +
# LayerNorm on every critic hidden layer, which is what makes a high replay
# ratio stable.
#
# THESE CHANGE THE CRITIC'S PARAMETERS, so they must be set for EVALS TOO or
# loading the checkpoint fails on unexpected ln_w/ln_b keys. That is why they
# live here and not on the sbatch command line: the eval loop sources this file.
# The same trap has now bitten ENV_IMAGE_SIZE, MIN_THROTTLE, MONO_HEAD and
# these -- anything that changes a module's shape belongs in the overlay.
export CRITIC_DROPOUT=0.01 CRITIC_LAYERNORM=1
