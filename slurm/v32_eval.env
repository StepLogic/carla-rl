# v32's EVAL overlay: v32's settings, but the standing Town02 eval set at 85%
# junction goals, so v32's numbers compare directly with v22-v30 (every one of
# which was evaluated on that set). Training uses 50% (slurm/v32_overlay.env);
# evaluating on 50% would change the test along with the policy.
. "$REPO/slurm/v32_overlay.env"
export JUNCTION_GOAL_FRAC=0.85
