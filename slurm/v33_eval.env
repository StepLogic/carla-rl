# v33 EVAL, the STANDING set: Town02 seeds 10000.., goals 5-25 m, 85% past a
# junction -- the same episodes v22-v32 were scored on, so v33 compares with
# them directly. (Training is 5-100 m at 50% junctions: slurm/v33_overlay.env.)
. "$REPO/slurm/v33_overlay.env"
export JUNCTION_GOAL_FRAC=0.85 GOAL_DIST_MIN=5 GOAL_DIST_MAX=25
