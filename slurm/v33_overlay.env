# v33 OVERLAY (user 2026-11-01: the ratchet reward "ok", "train goals to be
# within 5-100m and explore success 100m", "start from scratch").
#
# Trained FROM SCRATCH: v30's checkpoints already carry the circling exploit
# (at its 300k peak some crossing episodes returned +41 on 25 m routes).
# Base: v32's settings -- v30's reward with junction goals fixed at 50% (no
# ramp) and the 0.05 idle cost.
. "$REPO/slurm/v32_overlay.env"

# 1. ROUTE PROGRESS ON NEW GROUND ONLY (ROUTE_PROGRESS_RATCHET; see
#    gated_reward). v30/v32's 0.3 retreat charge was farmable by circling a
#    block through legal junction turns: v32 at 200k scored 0.000 on Town02,
#    13/40 episodes driving ~240 m for the whole clock and returning up to +95
#    without arriving. Under the ratchet, circling can never pay more than the
#    starting distance, and driving the wrong way costs nothing.
export ROUTE_RETREAT_SCALE=1 ROUTE_PROGRESS_RATCHET=1

# 2. GOALS 5-100 m, up from 5-25 m. Set HERE: train_sac.sbatch hard-exports
#    GOAL_DIST_MIN/MAX before sourcing the overlay. HER's hindsight legs follow
#    the same band (min_m/max_m read these).
export GOAL_DIST_MIN=5 GOAL_DIST_MAX=100

# 3. EXPLORE SUCCESS AT 100 m of driven path: the explore episode ends with its
#    +10 arrival (EXPLORE_ARRIVAL_BONUS); the +10 per junction cleared stays.
export EXPLORE_GOAL_DIST_M=100

# 4. VALUE CEILINGS 150 -> 300. A 100 m goal is worth up to ~+200 (100 m of
#    progress + the 100 arrival) and a 100 m explore episode ~+160 with its
#    junctions; at 150 the critic targets of the best states would be clipped.
export TQC_VALUE_CEILING=300 EXPLORE_VALUE_CEILING=300
