# v36 OVERLAY (user 2026-11-03: "switch reward to lane following as in the
# repo i pasted - add goal rewards for when the agent reaches a goal and chain
# till 200m"; then "add small per step penalty and remove idle").
#
# THE REPO (nisheeth-golakiya/carla-rl): each step pays the metres driven along
# the lane; a lane change costs -1 and ends the episode. Here goal mode is paid
# exactly that EVERYWHERE -- no route-progress term at all (v35 kept it inside
# junction zones) -- plus +100 on reaching the goal, a flat 0.02 per step, and
# chained goals until 200 m driven. The goal reaches the reward through the
# arrival bonus only (v52's form).
#
# Built on v35 (v30's recipe + goal chaining + its launch settings), with:
. "$REPO/slurm/v35_overlay.env"

# No route term anywhere: zone off, potential off, retreat charge moot.
export GOAL_ZONE_M=0 POTENTIAL_K=0 ROUTE_RETREAT_SCALE=1
# Lane following: forward progress along the lane, x1 (GOAL_ROUTE_ONLY=0 from v35).

# Every fault -1 and terminal, as the repo (v26 set the -1 fines and terminal
# crossings; v27 had made off-road non-fatal). Collisions are terminal (v52).
export EXPLORE_OFF_ROAD_FATAL=1

# +100 on arrival (GOAL_EXPLORE_ARRIVAL_BONUS from v26), chained to 200 m (v35).

# Small per-step penalty; no idle term.
export GOAL_STEP_PENALTY=0.02
export EXPLORE_IDLE_PENALTY=0
