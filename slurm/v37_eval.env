# v37 eval: Town02 standing set (5-25 m, 85% past a junction), one goal per
# episode (chaining is training-only). The throttle floor comes with the
# overlay, so the eval uses the action mapping the policy trained under.
. "$REPO/slurm/v37_overlay.env"
export JUNCTION_GOAL_FRAC=0.85 GOAL_DIST_MIN=5 GOAL_DIST_MAX=25
